# Copy the per-service examples into place before running docker compose:
#   cp backend/.env.example      backend/.env
#   cp python-agent/.env.example python-agent/.env
#
# This root file documents the shared secrets that must be identical across
# services. The JWT secret in particular MUST match between backend and
# python-agent, since the backend signs tokens the agent verifies.

# Must be identical in backend/.env and python-agent/.env
JWT_SECRET=change-me-to-a-long-random-string

# Your Anthropic API key (used by python-agent)
ANTHROPIC_API_KEY=sk-ant-...
