# Copy to .env and fill in real values.

# Must match backend/.env exactly
JWT_SECRET=change-me-to-a-long-random-string

# This app is Anthropic-only. A key saved via the frontend Integrations page
# (Mongo-backed) takes precedence over this static value at runtime.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Local dev defaults; docker-compose overrides these to the service hostnames
MONGO_URI=mongodb://localhost:27017
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_COLLECTION=documents

# --- Enterprise integrations (stubbed until real credentials are supplied) ---
CRM_BASE_URL=
CRM_API_KEY=

# Per-user delegated auth — the backend owns the OAuth connect/callback flow
# and writes tokens to the shared "outlook_connections" Mongo collection;
# these are used here only to refresh an expired access token, via the
# tenant-agnostic /organizations/ endpoint (see outlook_store.py) — the app
# is registered as multi-tenant so any franchise business's M365 tenant works.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Web search tool (stubbed) — plug in Tavily/Bing/SerpAPI here
SEARCH_API_KEY=
