# Copy to .env and fill in real values.

PORT=3000
NODE_ENV=development

# Must match python-agent/.env exactly
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Local dev default; docker-compose overrides this to mongodb://mongo:27017/agent
MONGO_URI=mongodb://localhost:27017/agent

# Local dev default; docker-compose overrides this to http://python-agent:8000
PYTHON_AGENT_URL=http://localhost:8000

# Local dev default; docker-compose overrides this to redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

CORS_ORIGIN=http://localhost:5173

# --- Enterprise integrations (stubbed until real credentials are supplied) ---

# CRM (generic REST CRM — adjust to your provider, e.g. Salesforce/HubSpot)
CRM_BASE_URL=
CRM_API_KEY=

# Microsoft Graph (Outlook mail/calendar) — per-user OAuth (authorization-code flow).
# The app must be registered as multi-tenant in Azure Portal > App registrations >
# your app > Authentication > "Accounts in any organizational directory" — we
# always call the /organizations/ endpoint (see outlook.service.ts), so any
# business's Microsoft 365 tenant can connect, not just one hardcoded tenant.
# Register this exact redirect URI under Authentication > Web > Redirect URIs.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_REDIRECT_URI=http://localhost:3000/outlook/callback

# Meta Cloud API (WhatsApp)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# SMTP (outbound email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
